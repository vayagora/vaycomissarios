# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Usada para criar acessos e sincronizar.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de criptografia das senhas dos programas guardadas pelo comissário (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave torna ilegíveis as senhas já guardadas.
CREDENTIALS_KEY=

# HubSpot: Service Key (Configurações › Integrações › Service Keys), só leitura:
# crm.objects.contacts.read e crm.objects.courses.read (objeto Créditos, 0-410)
HUBSPOT_TOKEN=
# ID da conta HubSpot (links "Abrir no HubSpot")
HUBSPOT_PORTAL_ID=44656712
# Senha da sincronização agendada (/api/cron/sync). A Vercel envia automaticamente.
CRON_SECRET=
